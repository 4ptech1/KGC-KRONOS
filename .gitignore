# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Python virtual environments
.venv/
venv/
env/

# Office temp and lock files
~$*

# Excel workbooks: never commit one, so a real company file can't slip in
*.xlsx
*.xlsm
*.xls
*.xlsb

# Run logs
logs/*.log

# Build output from vclc: only dist/forge_module.bas, forge_selftest.bas and forge_pilot.bas are kept
# (CI checks they are up to date)
dist/*
!dist/forge_module.bas
!dist/forge_selftest.bas
!dist/forge_pilot.bas
