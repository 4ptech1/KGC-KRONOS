# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Python virtual environments
.venv/
venv/
env/

# Office temp and lock files
~$*

# Excel workbooks: never commit one, so a real company file can't slip in
*.xlsx
*.xlsm
*.xls
*.xlsb
# ... except the KRONOS demo's invented workbooks, made by docs/demo/make_demo.py and checked by tests/test_demo.py (D88)
!docs/demo/NCR_Register_Demo*.xlsx
# ... and the real KGC samples Boss published on 20 Nov 2026 (D105, D106), listed with their SHA-256 in samples/kgc/README.md
!samples/kgc/*.xlsx
# ... and the invented look-alike KGC templates, made by data/templates/make_templates.py and checked by
# tests/test_templates.py (D108)
!data/templates/*.xlsx

# Run logs
logs/*.log

# Build output from vclc: only dist/forge_module.bas, forge_selftest.bas and forge_pilot.bas are kept
# (CI checks they are up to date)
dist/*
!dist/forge_module.bas
!dist/forge_selftest.bas
!dist/forge_pilot.bas

# PyInstaller's work folder (KRONOS.exe is built into dist/, which is ignored above)
build/
