' VBA Forge pilot: runs the TESTs of task_12.vcl in Excel and writes
' the results to the sheet ForgePilot. Generated by compiler/vcl_pilot.py; do not edit by hand.
' Paste into a NEW module next to forge_module.bas, then run ForgePilotRun (docs/excel-pilot.md).
Option Explicit

Private Const SANDBOX_MAX_ROOT As Long = 120
Private Const SANDBOX_TEST_ROOT As Long = 17   ' the interpreter's C:\KRONOS_SANDBOX
Private gOut As Worksheet
Private gLine As Long

Public Sub ForgePilotRun()
    ' Runs every TEST of the piloted specs. Results: the sheet ForgePilot, one line per row.
    On Error GoTo PilotFailed
    Set gOut = FixtureSheet(ThisWorkbook, "ForgePilot")
    gLine = 0
    PilotLine "PILOT 1 spec(s)"
    PilotLine "DATE " & ForgeText(Date)
    PilotSpec_task_12
    PilotLine "END"
    gOut.Columns("A").AutoFit
    MsgBox "Pilot done: " & gLine & " lines on the sheet ForgePilot. Copy column A and paste it to Claude."
    Exit Sub
PilotFailed:
    PilotLine "ABORTED error " & Err.Number & ": " & Err.Description
    ForgeSandboxUnlock
    MsgBox "Pilot stopped by error " & Err.Number & ". Copy column A of the sheet ForgePilot to Claude."
End Sub

Private Sub PilotLine(ByVal s As String)
    gLine = gLine + 1
    ForgeSetValue gOut.Cells(gLine, 1), s
End Sub

Private Function PilotEscape(ByVal s As String) As String
    PilotEscape = Replace(Replace(Replace(s, vbLf, "{LF}"), vbCr, "{CR}"), vbTab, "{TAB}")
End Function

Private Function PilotColor(ByVal c As Long) As String
    ' Interior.Color is BGR: #RRGGBB as the interpreter writes fills.
    PilotColor = "#" & Right$("0" & Hex(c And &HFF), 2) & Right$("0" & Hex((c \ &H100) And &HFF), 2) & _
        Right$("0" & Hex((c \ &H10000) And &HFF), 2)
End Function

Private Sub PilotReport(ByVal specLine As Long, ByVal result As Variant, ByVal isFunction As Boolean, _
        ByVal root As String, ByVal sheetNames As Variant)
    ' One TEST's lines: RESULT and ERROR_COUNT, then every value and fill of its sheets, then its files.
    Dim i As Long
    Dim ws As Worksheet
    Dim c As Range
    PilotLine "TEST " & specLine & " RESULT=" & IIf(isFunction, ForgeText(result), "(none)") & " ERRORS=" & ForgeErrorCount()
    For i = LBound(sheetNames) To UBound(sheetNames)
        Set ws = ThisWorkbook.Worksheets(sheetNames(i))
        For Each c In ws.UsedRange.Cells
            If Not IsEmpty(c.Value) Then
                PilotLine "CELL " & ws.Name & " " & c.Row & " " & c.Column & " [" & PilotEscape(ForgeText(c.Value)) & "]"
            End If
            If c.Interior.ColorIndex <> xlColorIndexNone Then
                PilotLine "FILL " & ws.Name & " " & c.Row & " " & c.Column & " " & PilotColor(c.Interior.Color)
            End If
        Next c
    Next i
    If Len(root) > 0 Then PilotFiles root, ""
End Sub

Private Sub PilotFiles(ByVal folderPath As String, ByVal rel As String)
    ' Every folder and file below folderPath, read only. The depth is the sandbox's, a few levels.
    Dim item As Object
    For Each item In SandboxFso().GetFolder(folderPath).SubFolders
        PilotLine "FOLDER " & rel & item.Name
        PilotFiles item.Path, rel & item.Name & "\"
    Next item
    For Each item In SandboxFso().GetFolder(folderPath).Files
        PilotLine "FILE " & rel & item.Name & " " & item.Size
    Next item
End Sub

Private Function FixtureSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    ' The sheet called sheetName in wb, added at the end if it is missing, and emptied.
    Dim ws As Worksheet
    Dim sh As Worksheet
    For Each sh In wb.Worksheets
        If StrComp(sh.Name, sheetName, vbTextCompare) = 0 Then Set ws = sh
    Next sh
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = sheetName
    End If
    ws.Cells.Clear
    Set FixtureSheet = ws
End Function

Private Sub FixtureWriteRow(ByVal ws As Worksheet, ByVal rowNo As Long, ByVal rowValues As Variant)
    Dim i As Long
    Dim n As Long
    Dim rowData() As Variant
    n = UBound(rowValues) - LBound(rowValues) + 1
    ReDim rowData(1 To 1, 1 To n)
    For i = 1 To n
        rowData(1, i) = rowValues(LBound(rowValues) + i - 1)
    Next i
    ws.Range(ws.Cells(rowNo, 1), ws.Cells(rowNo, n)).Value = rowData
End Sub

Private Sub FixtureStaleFill(ByVal ws As Worksheet, ByVal rowNo As Long, ByVal nCols As Long)
    ' stale=<n>: a leftover red fill from an earlier run, across the header's columns.
    ws.Range(ws.Cells(rowNo, 1), ws.Cells(rowNo, nCols)).Interior.Color = RGB(255, 0, 0)
End Sub

' ---- VCL 0.3 folder FIXTUREs: the sandbox (D30). Nothing here deletes or overwrites anything. ----

Private Function SandboxFso() As Object
    Set SandboxFso = CreateObject("Scripting.FileSystemObject")
End Function

Private Function SandboxNewRoot() As String
    ' A new folder below %TEMP%, named by the time and a count (one sandbox per TEST, several a
    ' second), so a builder never writes into an old one.
    Dim stem As String
    Dim root As String
    Dim n As Long
    If Len(Environ$("TEMP")) = 0 Then Err.Raise vbObjectError + 513, "SandboxNewRoot", "TEMP is not set"
    stem = SandboxFso().GetAbsolutePathName(Environ$("TEMP") & "\KGC_KRONOS_SANDBOX_" & Format$(Now, "yyyymmdd_hhnnss"))
    For n = 1 To 99
        root = stem & "_" & n
        If Not SandboxFso().FolderExists(root) And Not SandboxFso().FileExists(root) Then Exit For
    Next n
    If Len(root) > SANDBOX_MAX_ROOT Then Err.Raise vbObjectError + 514, "SandboxNewRoot", _
        root & " has " & Len(root) & " characters; a longer root than " & SANDBOX_MAX_ROOT & " could change a TEST's statuses"
    SandboxFolder root
    Debug.Print "Sandbox: " & root & " (" & Len(root) & " characters; the interpreter's root has " & SANDBOX_TEST_ROOT & ")"
    SandboxNewRoot = root
End Function

Private Sub SandboxFolder(ByVal path As String)
    ' CreateFolder raises error 58 for a folder that is already there, so nothing old is reused.
    SandboxFso().CreateFolder path
End Sub

Private Sub SandboxFile(ByVal path As String, ByVal bytes As Long)
    ' A dummy report of exactly bytes characters: "x" repeated, with no line break.
    Dim f As Long
    If SandboxFso().FileExists(path) Or SandboxFso().FolderExists(path) Then
        Err.Raise vbObjectError + 515, "SandboxFile", path & " is already there"
    End If
    f = FreeFile
    Open path For Output As #f
    Print #f, String$(bytes, "x");
    Close #f
End Sub

Private Sub SandboxLock(ByVal path As String)
    ' locked=: held open with no sharing, as if another program had it, until ForgeSandboxUnlock.
    Dim f As Long
    f = FreeFile
    Open path For Binary Access Read Lock Read Write As #f
End Sub

Private Sub ForgeSandboxUnlock()
    ' Closes the locked= files (and any other file this VBA project has open).
    Close
End Sub

Private Sub PilotSpec_task_12()
    Dim root As String
    Dim result As Variant
    Dim i As Long
    PilotLine "SPEC task_12.vcl"
    ' TEST on spec line 43
    ForgeFixture_jobpacks_01 ThisWorkbook
    root = ForgeSandbox_jobpacks_01()
    result = Empty
    For i = 1 To 1
        ForgeClearLog
        result = RouteJobPacks(ThisWorkbook.Worksheets("Tracker"), root & "\Dump", root & "\Jobs")
    Next i
    ForgeSandboxUnlock
    PilotReport 43, result, True, root, Array("Tracker", "Notes")
    ' TEST on spec line 44
    ForgeFixture_jobpacks_01 ThisWorkbook
    root = ForgeSandbox_jobpacks_01()
    result = Empty
    For i = 1 To 2
        ForgeClearLog
        result = RouteJobPacks(ThisWorkbook.Worksheets("Tracker"), root & "\Dump", root & "\Jobs")
    Next i
    ForgeSandboxUnlock
    PilotReport 44, result, True, root, Array("Tracker", "Notes")
    ' TEST on spec line 45
    ForgeFixture_jobpacks_01 ThisWorkbook
    root = ForgeSandbox_jobpacks_01()
    result = Empty
    For i = 1 To 1
        ForgeClearLog
        result = RouteJobPacks(ThisWorkbook.Worksheets("Tracker"), root & "\Dump", "X:\KRONOS_NO_SUCH_FOLDER")
    Next i
    ForgeSandboxUnlock
    PilotReport 45, result, True, root, Array("Tracker", "Notes")
    ' TEST on spec line 46
    ForgeFixture_jobpacks_01 ThisWorkbook
    root = ForgeSandbox_jobpacks_01()
    result = Empty
    For i = 1 To 1
        ForgeClearLog
        result = RouteJobPacks(ThisWorkbook.Worksheets("Notes"), root & "\Dump", root & "\Jobs")
    Next i
    ForgeSandboxUnlock
    PilotReport 46, result, True, root, Array("Tracker", "Notes")
End Sub

' FIXTURE jobpacks_01.xlsx: generated by compiler/vcl_fixtures.py from the spec's FIXTURE lines.
Private Sub ForgeFixture_jobpacks_01(ByVal wb As Workbook)
    ForgeFixture_jobpacks_01_Tracker wb
    ForgeFixture_jobpacks_01_Notes wb
End Sub

Private Sub ForgeFixture_jobpacks_01_Tracker(ByVal wb As Workbook)
    Dim ws As Worksheet
    Set ws = FixtureSheet(wb, "Tracker")
    FixtureWriteRow ws, 1, Array("Job ID", "Report File", "Status")
    FixtureWriteRow ws, 2, Array("'J-101", "'r1.pdf", "old")
    FixtureWriteRow ws, 3, Array("'J-102", "'r2.pdf", "old")
    FixtureWriteRow ws, 4, Array("'J-103", "'r3.pdf", "old")
    FixtureWriteRow ws, 5, Array("..\x", "'r4.pdf", "old")
    FixtureWriteRow ws, 6, Array("'J-104", "'r5.pdf", "old")
    FixtureWriteRow ws, 7, Array(Empty, "'r1.pdf", "old")
    FixtureWriteRow ws, 8, Array("'J-105", "'r9.pdf", "old")
    FixtureWriteRow ws, 9, Array("'J-101", "'r4.pdf", "old")
    FixtureWriteRow ws, 10, Array("'J-106", "CON.pdf", "old")
    FixtureWriteRow ws, 11, Array("'J-107", "'r6.pdf", "old")
End Sub

Private Sub ForgeFixture_jobpacks_01_Notes(ByVal wb As Workbook)
    Dim ws As Worksheet
    Set ws = FixtureSheet(wb, "Notes")
    FixtureWriteRow ws, 1, Array("Note")
    FixtureWriteRow ws, 2, Array("WZJCNIZAJU")
    FixtureWriteRow ws, 3, Array("ULDVSDBIGB")
    FixtureWriteRow ws, 4, Array("DYMVLLNARW")
End Sub

' FIXTURE jobpacks_01.xlsx folders: generated by compiler/vcl_fixtures.py from the spec's FIXTURE lines.
Private Function ForgeSandbox_jobpacks_01() As String
    Dim root As String
    root = SandboxNewRoot()
    SandboxFolder root & "\Dump"
    SandboxFile root & "\Dump\r1.pdf", 120
    SandboxFile root & "\Dump\r2.pdf", 80
    SandboxFile root & "\Dump\r3.pdf", 952
    SandboxFile root & "\Dump\r4.pdf", 64
    SandboxFile root & "\Dump\r5.pdf", 863
    SandboxFile root & "\Dump\r6.pdf", 70
    SandboxFolder root & "\Jobs"
    SandboxFolder root & "\Jobs\J-102"
    SandboxFile root & "\Jobs\J-102\r2.pdf", 99
    SandboxFile root & "\Jobs\J-104", 5
    SandboxFolder root & "\Jobs\J-107"
    SandboxFile root & "\Jobs\J-107\r6.pdf", 70
    SandboxLock root & "\Dump\r3.pdf"
    ForgeSandbox_jobpacks_01 = root
End Function

