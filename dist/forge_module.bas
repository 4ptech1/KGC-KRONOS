    gForgeLog.Add procName & " | error " & errNumber & " | spec line " & (lineNo \ 10) & " | " & message
    Debug.Print "ForgeLog: " & procName & " | " & errNumber & " | " & message
End Sub

Public Sub ForgeInfo(ByVal procName As String, ByVal message As String)
