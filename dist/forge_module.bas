'@VCL PROC=ReconcileConsumableStock  source: task_08.vcl
Public Function ReconcileConsumableStock(ByVal issues As Worksheet, ByVal inv As Worksheet) As Long
          Dim known As Object
          Dim issued As Object
          Dim iBatch As Long
          Dim iQty As Long
          Dim vBatch As Long
          Dim vOpen As Long
          Dim vIssued As Long
          Dim vBal As Long
          Dim vRemark As Long
          Dim batch As String
          Dim used As Double
          Dim unknown As Long
          Dim r As Long
          Dim forgeScreen As Boolean
          Dim forgeCalc As Long
          Dim forgeEvents As Boolean
          forgeScreen = Application.ScreenUpdating
          forgeCalc = Application.Calculation
          forgeEvents = Application.EnableEvents
          On Error GoTo ErrHandler
          Set known = ForgeNewDict()
          Set issued = ForgeNewDict()
250       If Not (ForgeCol(issues, "Batch No") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($issues,""Batch No"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
251       If Not (ForgeCol(issues, "Qty Issued") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($issues,""Qty Issued"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
252       If Not (ForgeCol(inv, "Batch No") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($inv,""Batch No"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
253       If Not (ForgeCol(inv, "Opening Stock") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($inv,""Opening Stock"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
254       If Not (ForgeCol(inv, "Issued to Date") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($inv,""Issued to Date"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
255       If Not (ForgeCol(inv, "Balance") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($inv,""Balance"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
256       If Not (ForgeCol(inv, "Remark") > 0) Then ForgeLog "ReconcileConsumableStock", 0, "PRE failed: (COL($inv,""Remark"")>0)", 250: ReconcileConsumableStock = -1: GoTo CleanExit
          Application.ScreenUpdating = False
          Application.Calculation = xlCalculationManual
260       iBatch = ForgeCol(issues, "Batch No")
270       iQty = ForgeCol(issues, "Qty Issued")
280       vBatch = ForgeCol(inv, "Batch No")
290       vOpen = ForgeCol(inv, "Opening Stock")
300       vIssued = ForgeCol(inv, "Issued to Date")
310       vBal = ForgeCol(inv, "Balance")
320       vRemark = ForgeCol(inv, "Remark")
330       For r = 2 To ForgeLastRow(inv, vBatch)
340           If (Not ForgeIsEmpty(inv.Cells(r, vBatch).Value)) Then ForgeDictAdd known, ForgeTrim(inv.Cells(r, vBatch).Value), r, "keep"
          Next r
350       unknown = 0
360       For r = 2 To ForgeLastRow(issues, iBatch)
370           batch = ForgeTrim(issues.Cells(r, iBatch).Value)
380           If ((Not ForgeIsEmpty(batch)) And ForgeIsNumber(issues.Cells(r, iQty).Value)) Then
390               If ForgeDictExists(known, batch) Then ForgeDictAdd issued, batch, issues.Cells(r, iQty).Value, "sum"
400               If (Not ForgeDictExists(known, batch)) Then unknown = (unknown + 1)
              End If
          Next r
410       For r = 2 To ForgeLastRow(inv, vBatch)
420           If (Not ForgeIsEmpty(inv.Cells(r, vBatch).Value)) Then
430               batch = ForgeTrim(inv.Cells(r, vBatch).Value)
440               used = 0
450               If ForgeDictExists(issued, batch) Then used = ForgeNum(ForgeDictGet(issued, batch))
460               inv.Cells(r, vIssued).Value = used
470               inv.Cells(r, vRemark).ClearContents
480               If ForgeIsNumber(inv.Cells(r, vOpen).Value) Then
490                   inv.Cells(r, vBal).Value = (ForgeNum(inv.Cells(r, vOpen).Value) - used)
500                   If ((ForgeNum(inv.Cells(r, vOpen).Value) - used) < 0) Then inv.Cells(r, vRemark).Value = "Negative balance"
                  Else
520                   inv.Cells(r, vBal).ClearContents
530                   inv.Cells(r, vRemark).Value = "Opening stock missing"
                  End If
              End If
          Next r
540       ReconcileConsumableStock = unknown
541       GoTo CleanExit
CleanExit:
          ForgeRestore forgeScreen, forgeCalc, forgeEvents
          Exit Function
ErrHandler:
          ForgeLog "ReconcileConsumableStock", Err.Number, Err.Description, Erl
          ReconcileConsumableStock = -2
          Resume CleanExit
End Function

