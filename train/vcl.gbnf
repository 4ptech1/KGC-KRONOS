# VCL as a GBNF grammar for llama.cpp (--grammar-file). Written by train/grammar_gbnf.py from vcl/grammar.lark
# and compiler/vcl_parse.py: do not edit; run `python train/grammar_gbnf.py`. See that file for what it is.

root ::= task-file | build-file | doc-file
nl ::= "\n"
sp ::= " "?
assume-line ::= "# ASSUME: " [^\n]+ nl
goal-line ::= "GOAL" "     " [ -~]{10,200} nl
proc-line ::= "PROC" "     " proc-value nl
kind-line ::= "KIND" "     " kind-value nl
module-line ::= "MODULE" "   " module-value nl
args-line ::= "ARGS" "     " args-value nl
ret-line ::= "RET" "      " ret-value nl
var-line ::= "VAR" "      " var-value nl
pre-line ::= "PRE" "      " pre-value nl
modifies-line ::= "MODIFIES" " " modifies-value nl
perf-line ::= "PERF" "     " perf-value nl
err-line ::= "ERR" "      " err-value nl
allow-line ::= "ALLOW" "    " allow-value nl
fixture-line ::= "FIXTURE" "  " fixture-value nl
test-line ::= "TEST" "     " test-value nl
name-line ::= "NAME" "     " name-value nl
target-line ::= "TARGET" "   " target-value nl
entry-line ::= "ENTRY" "    " entry-value nl
form-line ::= "FORM" "     " form-value nl
sig-line ::= "SIG" "      " sig-value nl
flow-line ::= "FLOW" "     " flow-value nl
template-line ::= "TEMPLATE" " " template-value nl
field-line ::= "FIELD" "    " field-value nl
repeat-line ::= "REPEAT" "   " repeat-value nl
keep-line ::= "KEEP" "     " keep-value nl
task-head ::= goal-line proc-line kind-line module-line args-line? ret-line? var-line* pre-line? modifies-line* op-block perf-line? err-line allow-line?
task-file ::= ("VCL 0.6" | "VCL 0.7") nl "TASK" nl assume-line* task-head fixture-line+ test-line+
build-06 ::= "VCL 0.6" nl "BUILD" nl assume-line* goal-line name-line target-line entry-line module-line+ form-line* sig-line+ flow-line+ fixture-line+ test-line+ ("---" nl "VCL 0.6" nl "TASK" nl assume-line* task-head)+
build-07 ::= "VCL 0.7" nl "BUILD" nl assume-line* goal-line name-line target-line entry-line module-line+ form-line* sig-line+ flow-line+ fixture-line+ test-line+ ("---" nl "VCL 0.7" nl "TASK" nl assume-line* task-head)+
build-file ::= build-06 | build-07
doc-file ::= "VCL 0.7" nl "DOCUMENT" nl assume-line* goal-line name-line template-line args-line? field-line* repeat-line* keep-line* fixture-line+ test-line+
op-block ::= stmt-0+
leaf-0 ::= "OP" "       " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-1 ::= stmt-1+
loop-0 ::= "OP" "       " (loop-rows | loop-cols | for-each) nl block-1
if-0 ::= "OP" "       " if-block nl block-1 ("OP" "       " else-line nl block-1)?
select-0 ::= "OP" "       " select-case nl (case-1+ case-else-1? | case-else-1)
case-1 ::= "OP" "         " case-line nl stmt-2*
case-else-1 ::= "OP" "         " case-else nl block-2
stmt-0 ::= leaf-0 | loop-0 | if-0 | select-0
leaf-1 ::= "OP" "         " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-2 ::= stmt-2+
loop-1 ::= "OP" "         " (loop-rows | loop-cols | for-each) nl block-2
if-1 ::= "OP" "         " if-block nl block-2 ("OP" "         " else-line nl block-2)?
select-1 ::= "OP" "         " select-case nl (case-2+ case-else-2? | case-else-2)
case-2 ::= "OP" "           " case-line nl stmt-3*
case-else-2 ::= "OP" "           " case-else nl block-3
stmt-1 ::= leaf-1 | loop-1 | if-1 | select-1
leaf-2 ::= "OP" "           " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-3 ::= stmt-3+
loop-2 ::= "OP" "           " (loop-rows | loop-cols | for-each) nl block-3
if-2 ::= "OP" "           " if-block nl block-3 ("OP" "           " else-line nl block-3)?
select-2 ::= "OP" "           " select-case nl (case-3+ case-else-3? | case-else-3)
case-3 ::= "OP" "             " case-line nl stmt-4*
case-else-3 ::= "OP" "             " case-else nl block-4
stmt-2 ::= leaf-2 | loop-2 | if-2 | select-2
leaf-3 ::= "OP" "             " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-4 ::= stmt-4+
loop-3 ::= "OP" "             " (loop-rows | loop-cols | for-each) nl block-4
if-3 ::= "OP" "             " if-block nl block-4 ("OP" "             " else-line nl block-4)?
select-3 ::= "OP" "             " select-case nl (case-4+ case-else-4? | case-else-4)
case-4 ::= "OP" "               " case-line nl stmt-5*
case-else-4 ::= "OP" "               " case-else nl block-5
stmt-3 ::= leaf-3 | loop-3 | if-3 | select-3
leaf-4 ::= "OP" "               " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-5 ::= stmt-5+
loop-4 ::= "OP" "               " (loop-rows | loop-cols | for-each) nl block-5
if-4 ::= "OP" "               " if-block nl block-5 ("OP" "               " else-line nl block-5)?
select-4 ::= "OP" "               " select-case nl (case-5+ case-else-5? | case-else-5)
case-5 ::= "OP" "                 " case-line nl stmt-6*
case-else-5 ::= "OP" "                 " case-else nl block-6
stmt-4 ::= leaf-4 | loop-4 | if-4 | select-4
leaf-5 ::= "OP" "                 " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-6 ::= stmt-6+
loop-5 ::= "OP" "                 " (loop-rows | loop-cols | for-each) nl block-6
if-5 ::= "OP" "                 " if-block nl block-6 ("OP" "                 " else-line nl block-6)?
select-5 ::= "OP" "                 " select-case nl (case-6+ case-else-6? | case-else-6)
case-6 ::= "OP" "                   " case-line nl stmt-7*
case-else-6 ::= "OP" "                   " case-else nl block-7
stmt-5 ::= leaf-5 | loop-5 | if-5 | select-5
leaf-6 ::= "OP" "                   " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-7 ::= stmt-7+
loop-6 ::= "OP" "                   " (loop-rows | loop-cols | for-each) nl block-7
if-6 ::= "OP" "                   " if-block nl block-7 ("OP" "                   " else-line nl block-7)?
select-6 ::= "OP" "                   " select-case nl (case-7+ case-else-7? | case-else-7)
case-7 ::= "OP" "                     " case-line nl stmt-8*
case-else-7 ::= "OP" "                     " case-else nl block-8
stmt-6 ::= leaf-6 | loop-6 | if-6 | select-6
leaf-7 ::= "OP" "                     " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-8 ::= stmt-8+
loop-7 ::= "OP" "                     " (loop-rows | loop-cols | for-each) nl block-8
if-7 ::= "OP" "                     " if-block nl block-8 ("OP" "                     " else-line nl block-8)?
select-7 ::= "OP" "                     " select-case nl (case-8+ case-else-8? | case-else-8)
case-8 ::= "OP" "                       " case-line nl stmt-9*
case-else-8 ::= "OP" "                       " case-else nl block-9
stmt-7 ::= leaf-7 | loop-7 | if-7 | select-7
leaf-8 ::= "OP" "                       " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
block-9 ::= stmt-9+
loop-8 ::= "OP" "                       " (loop-rows | loop-cols | for-each) nl block-9
if-8 ::= "OP" "                       " if-block nl block-9 ("OP" "                       " else-line nl block-9)?
stmt-8 ::= leaf-8 | loop-8 | if-8
leaf-9 ::= "OP" "                         " (if-inline | exit-if | skip-if | exit-loop-if | note | call) nl
stmt-9 ::= leaf-9

# the value of each line: vcl/grammar.lark
proc-value ::= t-name
kind-value ::= t-kind-word
module-value ::= t-name
args-value ::= param (sp "," sp param)*
param ::= t-name sp "As" sp t-type
ret-value ::= t-type
var-value ::= t-name sp "As" sp t-type
pre-value ::= expr (sp ";" sp expr)*
modifies-value ::= t-arg ((sp modifies-cols | sp t-fills-word | sp t-files-word | sp t-sheets-word))?
modifies-cols ::= "[" sp t-string (sp "," sp t-string)* sp "]"
op-value ::= statement
perf-value ::= (t-perf-flag) (sp t-perf-flag)*
err-value ::= t-err-word
allow-value ::= (t-allow-word) (sp t-allow-word)*
fixture-value ::= t-filename sp "sheet=" sp t-name sp "cols=" sp col-list sp "rows=" sp t-int (sp stale-opt)? (sp "data=" sp data-list)? | t-filename sp "folder=" sp t-name (sp folder-files)? (sp folder-locked)? | t-filename sp "template=" sp t-name
stale-opt ::= "stale=" sp t-int
read-opt ::= "read=" sp t-filename
test-value ::= "fixture=" sp t-filename (sp read-opt)? sp "call=" sp call-target sp "(" (sp call-arg (sp "," sp call-arg)*)? sp ")" (sp "runs=" sp t-int)? sp "assert=" sp assertion
template-value ::= t-docxname
field-value ::= t-name sp "=" sp expr
repeat-value ::= t-repeat-kind sp repeat-target sp "from=" (sp expr | sp empty-list) (sp match-opt)? (sp bind (sp "," sp bind)*)?
empty-list ::= "[" sp "]"
repeat-target ::= t-table-eq sp t-int | t-name
match-opt ::= t-match-eq sp t-int sp "=" sp t-name
bind ::= t-name sp "=" sp t-int
keep-value ::= t-name sp "IF" sp expr
name-value ::= t-name
target-value ::= t-target-word
entry-value ::= t-qualname
form-value ::= t-name sp "CONTROLS" (sp control)+
control ::= t-name sp ":" sp t-control-type
sig-value ::= t-qualname sp "(" (sp param (sp "," sp param)*)? sp ")" (sp "As" sp t-type)?
flow-value ::= t-qualname (sp "->" sp t-qualname)+
statement ::= loop-rows | loop-cols | for-each | if-inline | if-block | else-line | select-case | case-line | case-else | exit-if | skip-if | exit-loop-if | note | call
loop-rows ::= "LOOP_ROWS" (sp option)+
loop-cols ::= "LOOP_COLS" (sp option)+
for-each ::= "FOR_EACH" (sp option)+
if-inline ::= "IF" sp expr sp "THEN" (sp call | sp note)
if-block ::= "IF" sp expr
else-line ::= "ELSE"
select-case ::= "SELECT_CASE" sp expr
case-line ::= "CASE" sp expr (sp "," sp expr)*
case-else ::= "CASE_ELSE"
exit-if ::= "EXIT_IF" sp expr
skip-if ::= "SKIP_IF" sp expr
exit-loop-if ::= "EXIT_LOOP_IF" sp expr
note ::= "NOTE" sp t-string
expr ::= or-expr
or-expr ::= and-expr (sp "OR" sp and-expr)*
and-expr ::= not-expr (sp "AND" sp not-expr)*
not-expr ::= "NOT" sp not-expr | comparison
comparison ::= concat (sp t-comp-op sp concat)?
concat ::= sum (sp "&" sp sum)*
sum ::= product (sp t-add-op sp product)*
product ::= unary (sp t-mul-op sp unary)*
unary ::= "-" sp unary | primary
primary ::= call | t-arg | t-name | t-qualname | t-string | t-number | t-color | list-lit | "(" sp expr sp ")"
call ::= t-name sp "(" (sp call-args)? sp ")"
call-args ::= call-item (sp "," sp call-item)*
call-item ::= option | expr
option ::= t-optkey sp "=" sp expr
list-lit ::= "[" sp expr (sp "," sp expr)* sp "]"
call-target ::= t-name | t-qualname
call-arg ::= t-name | t-qsheet | t-string | t-number | neg-number | t-filename
neg-number ::= "-" sp t-number
assertion ::= a-cond (sp "AND" sp a-cond)*
a-cond ::= a-sum (sp t-comp-op sp a-sum)?
a-sum ::= a-atom (sp t-add-op sp a-atom)*
a-atom ::= a-func | "-" sp a-atom | t-name | t-number | t-string | "(" sp a-sum sp ")"
a-func ::= t-name sp "(" sp a-arg (sp "," sp a-arg)* sp ")"
a-arg ::= sheet-ref | t-qsheet | a-sum | t-color
sheet-ref ::= (t-name | t-qsheet) sp "!" (sp t-header-ref | sp t-a1-ref)
col-list ::= col-def (sp "," sp col-def)*
col-def ::= t-colletter sp ":" sp t-header-text
data-list ::= data-def (sp ";" sp data-def)*
data-def ::= t-colletter sp ":" sp rule (sp "+" sp modifier)*
rule ::= values-rule | seq-rule | int-rule | num-rule | dates-rule | reldates-rule | text-rule
values-rule ::= "values(" sp value-item (sp "," sp value-item)* sp ")"
value-item ::= t-string sp "x" sp t-int
seq-rule ::= "seq(" sp t-signed-num sp "," sp t-signed-num sp ")"
int-rule ::= "int(" sp t-signed-num sp "," sp t-signed-num sp ")"
num-rule ::= "num(" sp t-signed-num sp "," sp t-signed-num sp ")"
dates-rule ::= "dates(" sp t-iso-date sp "," sp t-iso-date sp ")"
reldates-rule ::= "reldates(" sp t-signed-num sp "," sp t-signed-num sp ")"
text-rule ::= "text(" sp t-int sp ")"
modifier ::= boundary-mod | blank-mod | dupes-mod
boundary-mod ::= "boundary(" sp boundary-value (sp "," sp boundary-value)* sp ")"
boundary-value ::= t-string | t-iso-date | t-signed-num
blank-mod ::= "blank(" sp t-int sp ")"
dupes-mod ::= "dupes(" sp t-int sp ")"
folder-files ::= "files=" sp file-entry (sp "," sp file-entry)*
file-entry ::= t-file-path (sp ":" (sp t-int | sp t-string))?
folder-locked ::= "locked=" sp t-file-path (sp "," sp t-file-path)*

# the terminals
t-optkey ::= ("dir" | "from" | "to" | "var" | "in" | "mode" | "into" | "key" | "order" | "header" | "what" | "fill" | "numfmt" | "bold" | "width" | "style" | "cols" | "col" | "crit" | "readonly" | "format" | "save" | "after" | "name" | "match")
t-kind-word ::= "Sub" | "Function"
t-type ::= "Long" | "Double" | "String" | "Boolean" | "Date" | "Variant" | "Range" | "Worksheet" | "Workbook" | "Dictionary" | "Collection"
t-perf-flag ::= "screen_off" | "calc_manual" | "events_off"
t-err-word ::= "standard"
t-fills-word ::= "fills"
t-files-word ::= "files"
t-sheets-word ::= "sheets"
t-allow-word ::= "file_delete" | "file_overwrite" | "shell" | "http"
t-target-word ::= "xlsm" | "xlam"
t-control-type ::= "TextBox" | "CommandButton" | "Label" | "ListBox" | "ComboBox" | "CheckBox" | "OptionButton"
t-comp-op ::= "<=" | ">=" | "<>" | "=" | "<" | ">"
t-add-op ::= "+" | "-"
t-mul-op ::= "*" | "/"
t-qualname ::= [A-Za-z_] [A-Za-z0-9_]* "." [A-Za-z_] [A-Za-z0-9_]*
t-name ::= [A-Za-z_] [A-Za-z0-9_]*
t-arg ::= "$" [A-Za-z_] [A-Za-z0-9_]*
t-string ::= "\"" ([^"\n\r] | "\"\"")* "\""
t-number ::= [0-9]+ ("." [0-9]+)?
t-signed-num ::= "-"? [0-9]+ ("." [0-9]+)?
t-int ::= [0-9]+
t-color ::= "#" [0-9A-Fa-f]{6}
t-filename ::= [a-z0-9_]+ ".xlsx"
t-docxname ::= [A-Za-z0-9_]+ ".docx"
t-repeat-kind ::= "row" | "column" | "section"
t-table-eq ::= "table="
t-match-eq ::= "match="
t-file-path ::= [A-Za-z0-9_.\-]+ ("\\" [A-Za-z0-9_.\-]+)*
t-colletter ::= [A-Z]{1,3}
t-header-text ::= [^,\r\n]+
t-iso-date ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2}
t-header-ref ::= "[" [^\]\n\r]+ "]" [0-9]*
t-qsheet ::= "'" ([^'\n\r] | "''")+ "'"
t-a1-ref ::= "$"? [A-Z]{1,3} "$"? [0-9]* (":" "$"? [A-Z]{1,3} "$"? [0-9]*)?
